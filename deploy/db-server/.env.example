# DB server settings. `sudo bash ../host/setup-host.sh db` creates .env from this file and
# replaces every __GENERATE__ with a random password. To do it by hand:
#   cp .env.example .env && chmod 600 .env   then set each password (openssl rand -hex 24).
# Use letters and digits only: the passwords go inside mongodb:// URLs.

# Exact image version: pinned so a re-pull never upgrades MongoDB by surprise.
MONGO_VERSION=8.0.34

# This server's IP. MongoDB listens on it (and on 127.0.0.1) only.
MONGO_BIND_IP=10.1.2.143

MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=__GENERATE__

# Application database and the password of its user (smartbranch_app).
# Check the database name against the current server before the first start (README, step 0).
SMARTBRANCH_DB_NAME=ZSmartBranch
SMARTBRANCH_DB_PASSWORD=__GENERATE__

MONGO_DATA_DIR=/opt/smartbranch/mongo/data
TZ=Africa/Addis_Ababa
