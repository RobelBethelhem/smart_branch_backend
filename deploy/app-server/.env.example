# App server settings read by docker-compose.  cp .env.example .env && chmod 600 .env

# Image version. Use a new tag for every release (date works well) and keep the old images:
# rolling back = putting the previous tag back here and running `docker compose up -d`.
IMAGE_TAG=2026.11.10-1

# Folder that holds the three repositories, relative to this folder or absolute.
# Default layout: /opt/smartbranch/{Smart_Branch,smart_branch_backoffice,smart_branch_backend}
# (this file is in smart_branch_backend/deploy/app-server, so that folder is three levels up).
SRC_DIR=../../..

# Host directory for persistent application files (backend uploads).
DATA_DIR=/opt/smartbranch/data

# ── Compiled into the browser code (rebuild the images after changing) ────────────────────
# Backend API address as the BROWSERS on the branch PCs reach it (customer-facing app).
# The backoffice needs no address: it calls /api on its own origin and nginx forwards it.
NEXT_PUBLIC_API_URL=http://10.1.2.132:5000
# Fingerprint capture service, used by both apps (backoffice: Biometric Registration). It runs
# on the Windows PC the ZK9500 scanner is plugged into; if every teller PC has its own
# scanner, use ws://localhost:8089 instead.
FINGERPRINT_WS_URL=ws://10.1.2.132:8089
# 64 hex characters. Copy from the current production Smart_Branch .env.local
# (it is visible to every browser).
NEXT_PUBLIC_RESPONSE_ENCRYPTION_KEY=

# ── Ports published on this server (same as the current deployment) ───────────────────────
FRONTEND_PORT=3000
BACKOFFICE_PORT=4000
BACKEND_PORT=5000
# If the start fails with "failed to bind host port 0.0.0.0:5000/tcp: address already in use",
# another program on this server holds that port on 127.0.0.1 (seen: Nutanix Guest Tools on
# 5000). Leave that program alone and publish on this server's network address only, e.g.
#   BACKEND_PORT=10.1.2.132:5000
# The address the branch PCs use stays the same. On the server itself, test with that address
# (curl http://10.1.2.132:5000/healthz), not with 127.0.0.1.

# FlexCube (Oracle) sessions EACH of the two apps that talk to it keeps open: the backend and
# the customer-facing app. 20 each = 40 sessions in total; confirm that with the DBAs.
# Do not go above 20 without also raising UV_THREADPOOL_SIZE in the two Dockerfiles (it must
# stay above this number, or the extra sessions can never be used at the same time).
FLEXCUBE_POOL_MAX=20

# Private Docker network for the three containers. Must not overlap any network the servers
# need to reach; change it if the bank uses 172.28.10.0/24 anywhere.
APP_SUBNET=172.28.10.0/24

TZ=Africa/Addis_Ababa
