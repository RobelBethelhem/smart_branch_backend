# smart_branch_backend — runtime configuration.   cp backend.env.example backend.env && chmod 600 backend.env
# Plain KEY=value lines, no quotes, no spaces around "=".
#
# Copy every key/secret below from the CURRENT production backend .env:
#   • ACCOUNT_ENCRYPTION_KEY / REQUEST_ENCRYPTION_KEY — data already encrypted with them becomes
#     unreadable if they change.
#   • ACCESS/REFRESH_TOKEN_PRIVATE_KEY — new values sign every user out (harmless, but noticed).
# Not needed here: PORT, ORACLE_CLIENT_PATH, NODE_ENV (set by docker-compose / the image).

# MongoDB on the DB server. Password = SMARTBRANCH_DB_PASSWORD from db-server/.env
DB=mongodb://smartbranch_app:CHANGE_ME@10.1.2.143:27017/ZSmartBranch?authSource=admin

# Browser origins allowed to call this API directly: the customer-facing app (:3000) and the
# backoffice (:4000 — it normally goes through its own /api proxy, kept for older pages).
CORS_ORIGINS=http://10.1.2.132:3000,http://10.1.2.132:4000

# Authentication
ACCESS_TOKEN_PRIVATE_KEY=
REFRESH_TOKEN_PRIVATE_KEY=
# bcrypt rounds for new password hashes (a number, e.g. 10)
SALT=10

# Encryption keys — 64 hex characters each; the backend refuses to start its crypto otherwise.
ACCOUNT_ENCRYPTION_KEY=
REQUEST_ENCRYPTION_KEY=

# Oracle FlexCube
FLEXCUBE_DB_USER=
FLEXCUBE_DB_PASSWORD=
# host:port/service, e.g. 10.1.1.149:1521/FCUBSPROD
FLEXCUBE_DB_CONNECTION_STRING=
FLEXCUBE_SCHEMA=
FLEXCUBE_RT_SERVICE_URL=https://api.zemenbank.com/soa-infra/services/default/FCUBSRTService/fcubsrtserviceprocess_client_ep

# SMS gateway
SMS_USERNAME=
SMS_PASSWORD=

# Troubleshooting only: logs every step of each FlexCube posting, including the full
# request and response. Leave off in normal operation, it slows every request down.
#FLEXCUBE_DEBUG=true

# The Authorizer's and Auditor's lists show today's requests plus posted work from this many
# earlier days that is still not authorized / audited. Default 7. (Unserved requests are not
# affected by this: they expire at the end of the day they were made.)
#CARRY_OVER_DAYS=7
