# Smart_Branch (customer-facing app) — runtime configuration for its server-side API routes.
#   cp frontend.env.example frontend.env && chmod 600 frontend.env
# Copy the values from the current production Smart_Branch .env.local.
# Set elsewhere: NEXT_PUBLIC_* (../.env, compiled in at build time), EXPRESS_BACKEND_URL and
# ORACLE_CLIENT_PATH (docker-compose).

# Oracle FlexCube (the API routes query it directly)
FLEXCUBE_DB_USER=
FLEXCUBE_DB_PASSWORD=
FLEXCUBE_DB_CONNECTION_STRING=
FLEXCUBE_SCHEMA=

# 64 hex characters
RESPONSE_ENCRYPTION_KEY=
